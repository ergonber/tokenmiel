# Runtime
NODE_ENV=production
LOG_LEVEL=info
PORT=3001

# Active chain (testnet = 98867, mainnet = 98866)
CHAIN_ID=98867

# Plume RPC (required)
PLUME_RPC_URL=https://your-plume-rpc-url.com

# Plume RPC fallbacks (optional)
PLUME_RPC_URL_FALLBACK_DRPC=
PLUME_RPC_URL_FALLBACK_THIRDWEB=

# Database (optional for M1)
DATABASE_URL=

# Redis (optional for M1)
REDIS_URL=

# GCP Cloud KMS for backend signing (optional for M1, required for production)
BACKEND_SIGNER_KMS_KEY_ID=projects/your-project/locations/us-east1/keyRings/your-keyring/cryptoKeys/your-key/cryptoKeyVersions/1
GCP_KMS_LOCATION=us-east1