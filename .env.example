# ============================================================================
# tokenization-platform — Example environment variables
# ============================================================================
# This is a template. Copy to .env.local and fill in real values.
# NEVER COMMIT .env or .env.local — they are in .gitignore.
# Real secrets live in HSM (AWS KMS / GCP KMS) or password manager.
# ============================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Blockchain — Plume Network (chain primaria)
# ---------------------------------------------------------------------------
# Primary RPC for the active chain — must match CHAIN_ID below (testnet host shown; mainnet: https://rpc.plume.org).
PLUME_RPC_URL=https://testnet-rpc.plume.org
# Active chain the backend connects to — the env loader reads CHAIN_ID (testnet 98867 / mainnet 98866).
CHAIN_ID=98867
# Reference chain ids (source: CIS §1). testnet 98867, mainnet 98866.
PLUME_TESTNET_CHAIN_ID=98867
PLUME_MAINNET_CHAIN_ID=98866
# RPC failover providers (ADR-023): viem fallback() — primario oficial + redundantes.
# Vacíos => se omiten del array fallback() (degradación graciosa, solo primario).
PLUME_RPC_URL_FALLBACK_DRPC=
PLUME_RPC_URL_FALLBACK_THIRDWEB=
PLUME_USDC_ADDRESS=0x0000000000000000000000000000000000000000
PLUME_EXPLORER_URL=https://explorer.plume.example

# ---------------------------------------------------------------------------
# Blockchain — Polygon PoS (chain secundaria, fase 6+)
# ---------------------------------------------------------------------------
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_FALLBACK_URL=https://polygon-mainnet.infura.io/v3/YOUR_KEY
POLYGON_CHAIN_ID=137
POLYGON_USDC_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# ---------------------------------------------------------------------------
# Smart contracts (filled after deployment)
# ---------------------------------------------------------------------------
ASSET_VAULT_ADDRESS_PLUME=
IDENTITY_REGISTRY_ADDRESS_PLUME=
REDEMPTION_MANAGER_ADDRESS_PLUME=
LAB_REGISTRY_ADDRESS_PLUME=

ASSET_VAULT_ADDRESS_POLYGON=
IDENTITY_REGISTRY_ADDRESS_POLYGON=
REDEMPTION_MANAGER_ADDRESS_POLYGON=
LAB_REGISTRY_ADDRESS_POLYGON=

# ---------------------------------------------------------------------------
# Safe multi-sig wallets (Plume + Polygon)
# ---------------------------------------------------------------------------
SAFE_ORACLE_PLUME=0x0000000000000000000000000000000000000000
SAFE_TREASURY_PLUME=0x0000000000000000000000000000000000000000
SAFE_ORACLE_POLYGON=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Backend signer (KMS key reference, NOT private key)
# ADR-022: GCP Cloud KMS (asymmetric secp256k1). Resource name points to a
# concrete cryptoKeyVersion. NEVER an AWS ARN (Zod bootstrap rejects ARN format).
# ---------------------------------------------------------------------------
BACKEND_SIGNER_KMS_KEY_ID=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/VERSION
GCP_KMS_LOCATION=us-east1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tokenization
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/tokenization

# ---------------------------------------------------------------------------
# Cache and queues
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------
GOLDSKY_API_URL=
GOLDSKY_API_KEY=

# ---------------------------------------------------------------------------
# KYC — Sumsub
# ---------------------------------------------------------------------------
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_API_BASE_URL=https://api.sumsub.com

# ---------------------------------------------------------------------------
# Auth — Clerk
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
MOONPAY_API_KEY=
MOONPAY_WEBHOOK_SECRET=
RAMP_API_KEY=
RAMP_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Storage — Arweave via Bundlr/Irys
# ---------------------------------------------------------------------------
IRYS_NODE_URL=https://node1.irys.xyz
# ADR-022: same GCP Cloud KMS custody as BACKEND_SIGNER (GCP resource name, NOT AWS ARN).
IRYS_FUNDING_WALLET_KMS_KEY_ID=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/VERSION

# ---------------------------------------------------------------------------
# Storage — Cloudflare R2
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=tokenization-docs

# ---------------------------------------------------------------------------
# Chainlink — Proof of Reserve
# ---------------------------------------------------------------------------
CHAINLINK_POR_FEED_PLUME=
CHAINLINK_POR_FEED_POLYGON=
CHAINLINK_BUILD_PROGRAM_KEY=

# ---------------------------------------------------------------------------
# Labs API integrations (oráculo de calidad)
# ---------------------------------------------------------------------------
IBNORCA_API_BASE_URL=
IBNORCA_API_KEY=
EUROFINS_API_BASE_URL=
EUROFINS_API_KEY=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
RESEND_API_KEY=
SLACK_WEBHOOK_URL_COMPLIANCE=
SLACK_WEBHOOK_URL_INCIDENTS=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=
BETTER_STACK_API_KEY=
PLAUSIBLE_DOMAIN=
# ADR-028: P0 alerts (backend down, contract pause, multi-sig pending > 24h) page via PagerDuty.
PAGERDUTY_INTEGRATION_KEY=

# ---------------------------------------------------------------------------
# Finality / reorg (ADR-025)
# ---------------------------------------------------------------------------
# Finality is keyed off the node's block tag (viem blockTag "safe"/"finalized"),
# NOT a hardcoded N of confirmations. No CONFIRMACIONES_FINALIDAD env needed.

# ---------------------------------------------------------------------------
# Frontend (Next.js requires NEXT_PUBLIC_ prefix for browser-side vars)
# ---------------------------------------------------------------------------
# Plume chain ids (source: CIS §1). testnet 98867, mainnet 98866.
NEXT_PUBLIC_PLUME_TESTNET_CHAIN_ID=98867
NEXT_PUBLIC_PLUME_MAINNET_CHAIN_ID=98866
NEXT_PUBLIC_POLYGON_CHAIN_ID=137
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_DEFAULT_CHAIN=plume
